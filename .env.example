# ─────────────────────────────────────────────────────────────────────────────
# Azure AI Foundry (the agent's model runs in this project's model deployment)
# ─────────────────────────────────────────────────────────────────────────────
# Project endpoint (must be HTTPS), format:
#   https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
# Name of a model deployment in that project (e.g. gpt-4o, gpt-4o-mini, gpt-5-mini).
FOUNDRY_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────────────────────
# Azure Databricks workspace
# ─────────────────────────────────────────────────────────────────────────────
# Workspace URL (must be HTTPS), e.g. https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_HOST=https://adb-0000000000000000.0.azuredatabricks.net
#
# Authentication to Azure Databricks uses Microsoft Entra ID OAuth (no personal access
# token and no Databricks CLI profile). The model always authenticates as the app's own
# identity; the Databricks identity is chosen by WEBAPP_DATABRICKS_IDENTITY (see below).
# Credentials resolve from the standard enterprise chain:
#   - Managed identity / workload identity (production, secretless) — recommended.
#   - Service principal via AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET.
#   - Azure CLI session (`az login`) for local development.
#
# Security: DATABRICKS_HOST and FOUNDRY_PROJECT_ENDPOINT must use https:// because a
# bearer token is sent to them; the app rejects non-HTTPS URLs.
#
# Optional: override the Entra ID token scope (only for sovereign / non-public clouds).
# Default is 2ff814a6-3304-4ab8-85cb-cd0e6f879c1d/.default (the Azure Databricks app).
# DATABRICKS_AZURE_SCOPE=

# ─────────────────────────────────────────────────────────────────────────────
# Databricks managed MCP targets
# ─────────────────────────────────────────────────────────────────────────────
# Unity Catalog functions managed MCP server -> /api/2.0/mcp/functions/{catalog}/{schema}
DATABRICKS_UC_CATALOG=main
DATABRICKS_UC_SCHEMA=default

# Genie space managed MCP server -> /api/2.0/mcp/genie/{space_id}. Optional: leave blank
# to run with only the Unity Catalog functions tool.
DATABRICKS_GENIE_SPACE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Multi-user web UI (foundry_databricks_agent.webapp)
# ─────────────────────────────────────────────────────────────────────────────
# The model always runs as the app's managed identity. Choose how the Databricks
# (Unity Catalog functions + Genie) tools authenticate:
#   obo  (default) — as the SIGNED-IN USER via On-Behalf-Of; Unity Catalog governs data
#                    access per user.
#   app            — as the APP's own managed identity; all signed-in users share the same
#                    Databricks data permissions.
# Both modes still require the user to sign in.
WEBAPP_DATABRICKS_IDENTITY=obo
#
# The app's Entra app registration (used for sign-in and, in `obo` mode, the OBO exchange).
# For `obo` it needs delegated permission `user_impersonation` on AzureDatabricks
# (2ff814a6-3304-4ab8-85cb-cd0e6f879c1d), admin-consented. If left blank in `obo` mode, the
# app runs in "direct token" mode: the incoming user token is used as the Databricks token
# as-is (useful for local testing). Not required in `app` mode.
WEBAPP_TENANT_ID=
WEBAPP_CLIENT_ID=

# How the app authenticates itself for the OBO exchange — choose ONE (obo mode only):
#
# (A) Secretless (RECOMMENDED for production). The app's managed identity authenticates
#     the confidential client via a federated identity credential — no secret stored.
#     Set WEBAPP_MANAGED_IDENTITY_CLIENT_ID to a user-assigned identity's client id, OR
#     set WEBAPP_USE_MANAGED_IDENTITY=1 to use the system-assigned identity. Requires a
#     federated identity credential on the app registration trusting that identity
#     (see DEPLOYMENT.md). When set, this takes precedence over WEBAPP_CLIENT_SECRET.
WEBAPP_MANAGED_IDENTITY_CLIENT_ID=
WEBAPP_USE_MANAGED_IDENTITY=
#
# (B) Client secret (handy for LOCAL testing). Simpler, but a long-lived secret.
WEBAPP_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Local interactive Entra ID sign-in (browser testing only; NOT for production)
# ─────────────────────────────────────────────────────────────────────────────
# When these are set (alongside WEBAPP_CLIENT_SECRET above), the app serves its own
# /auth/login + /auth/callback so you can sign in with Microsoft in the browser on
# your machine. In production you instead front the app with EasyAuth and leave these
# unset. The redirect URI must be registered on the app registration (Web platform).
# WEBAPP_REDIRECT_URI=http://localhost:8000/auth/callback
# WEBAPP_API_SCOPE=api://<WEBAPP_CLIENT_ID>/access_as_user
#
# Local-only shortcut: bypass sign-in entirely and run as your `az login` identity.
# NEVER set this in a deployed environment.
# WEBAPP_LOCAL_DEV=

# ─────────────────────────────────────────────────────────────────────────────
# Conversation history (Azure Cosmos DB)
# ─────────────────────────────────────────────────────────────────────────────
# When COSMOS_ENDPOINT is set, agent conversations are stored in Cosmos DB, so history
# survives restarts and is shared across replicas. Leave it blank to keep conversations
# in process memory (fine for local development; lost on restart).
#
# Authentication is Microsoft Entra ID via Cosmos data-plane RBAC — no account keys. The
# app's identity needs the built-in "Cosmos DB Built-in Data Contributor" role on the
# account (the Bicep deployment assigns it). Locally, your `az login` identity needs it.
# Conversations expire automatically via the container's TTL (30 days by default).
COSMOS_ENDPOINT=
COSMOS_DATABASE=agent
COSMOS_CONTAINER=conversations
